# Backend .gitignore

# Dependencies
node_modules/

# Build Output
dist/
build/
*.tsbuildinfo

# Environment & Secrets (CRITICAL: Never commit to Git)
.env
.env.*
*.env
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
.nyc_output/

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Temporary files & cache
.npm
*.tmp
