# Backend .gitignore

# Dependencies
node_modules/

# Build Output
dist/
build/
*.tsbuildinfo

# Environment & Secrets (NEVER COMMIT!)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
.nyc_output/

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Temporary files & cache
.npm
*.tmp
